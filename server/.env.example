NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Atlas connection string. URL-encode special characters in your password.
MONGODB_URI=
# Optional: comma-separated resolver IPs for this Node process only.
# Leave blank unless the default DNS resolver fails Atlas SRV/TXT lookups.
# Example: 1.1.1.1,8.8.8.8
MONGODB_DNS_SERVERS=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Keep false locally. True only for cross-site HTTPS deployments (Vercel + Render).
COOKIE_CROSS_SITE=false
# Render has one reverse proxy; use 0 locally.
TRUST_PROXY=0
# Reserved for the image analysis / matching and upload milestones.
GEMINI_API_KEY=
GEMINI_MODEL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
